{
  "manifest_version": 3,
  "name": "RevoRenew v2",
  "version": "2.0.0",
  "description": "Extensión para renovar anuncios de Revolico. Actualizada para la nueva UI de Revolico (Sep 2026). Sin dependencia de licencia externa.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.revolico.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RevoRenew v2",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.revolico.com/account*",
        "https://www.revolico.com/item/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
